# フロントエンド (Vite) のビルド時環境変数。
# このファイルをコピーして `.env`（または `.env.local`）を作り、必要に応じて上書きする。
# 反映にはビルドが必要: pnpm -C packages/frontend build

# /webrtc ブラウザ (SyncClient) が直接つなぐ chat_sync のシグナリング WebSocket URL。
# 既定は本番 (packages/frontend/src/webRTC/syncConfig.ts の DEFAULT_CHAT_SYNC_WS_URL)。
#   本番:        wss://chat.knd.cloud/ws
#   ローカル検証: ws://localhost:3000/ws   (chat_sync を production モードで起動した場合)
# TURN/STUN ホストはこの URL のホスト名から導出される。
VITE_CHAT_SYNC_URL=wss://chat.knd.cloud/ws
