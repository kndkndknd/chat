{
  "name": "backend",
  "packageManager": "pnpm@8.12.1",
  "private": true,
  "scripts": {
    "dev": "tsx src/app.ts",
    "watch": "tsx watch src/app.ts",
    "backend": "node --loader ts-node/esm src/app.ts",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node scripts/copyJsonAssets.mjs",
    "start": "node dist/app.js",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/express": "4.17.18"
  },
  "dependencies": {
    "axios": "1.21.1",
    "dotenv": "18.0.10",
    "express": "4.22.3",
    "ioredis": "6.0.0",
    "mongodb": "^6.22.0",
    "pcm": "1.1.0",
    "serve-favicon": "2.5.1",
    "sharp": "0.35.5",
    "ws": "8.23.0"
  },
  "optionalDependencies": {
    "bufferutil": "4.2.0"
  }
}
